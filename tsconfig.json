{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonJS",
    "lib": ["ES2020"],
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}